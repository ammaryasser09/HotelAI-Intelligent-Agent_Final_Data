# Copy this file to .env and put your own values in it. Never commit .env.
#   Windows:  Copy-Item .env.example .env

# Your local PostgreSQL. If the password has @ in it, write it as %40
DATABASE_URL=postgresql+psycopg://postgres:YOUR_PASSWORD@localhost:5432/hotelai

# Secret that signs the login tokens. Make your own with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=CHANGE_ME

# Payments: mock = fake Paymob page built into the API (default), paymob = Paymob test mode
PAYMENT_PROVIDER=mock

# Paymob (test mode keys from eg.dashboard.paymob.com: Settings > API Keys and Payment Integrations).
# Leave them empty to use the fake Paymob built into the API.
PAYMOB_API_KEY=
PAYMOB_PUBLIC_KEY=
PAYMOB_SECRET_KEY=
PAYMOB_HMAC_SECRET=
PAYMOB_INTEGRATION_ID=

# Where Paymob can reach this API (needed only for PAYMENT_PROVIDER=paymob).
# On a laptop that is the ngrok link, e.g. https://abcd-1234.ngrok-free.app
PUBLIC_BASE_URL=

# Emails to guests: log = written as text files in logs/emails/ (default, nothing is sent).
# smtp = really sent, e.g. Gmail: SMTP_HOST=smtp.gmail.com, SMTP_USER=you@gmail.com, SMTP_PASSWORD=an App Password
EMAIL_PROVIDER=log
SMTP_HOST=
SMTP_USER=
SMTP_PASSWORD=
# EMAIL_FROM=Nile Pearl Hotel <you@gmail.com>

# Optional (these are the defaults)
# RATE_LIMIT=60/minute
# LOGIN_RATE_LIMIT=5/minute
# ACCESS_TOKEN_MINUTES=60
# EXPIRY_CHECK_SECONDS=300
# CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]
